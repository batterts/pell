module explain_plan;

import mermaid;
import dbms_output;
import catalog;

// ---------------------------------------------------------------------------
// explain_plan — turn an Oracle execution plan into a readable picture.
//
// `EXPLAIN PLAN` fills PLAN_TABLE with a parent/child tree of operations.
// Read raw it's a wall of indented text. This package has several lenses,
// cheap to expensive:
//
//   as_story(id)     -> the plan as prose, in the order Oracle *starts*
//                       the operations (leaf-first), with "meanwhile"
//                       dividers where it crosses to the other join input
//   as_tree(id)      -> the same structure as an indented tree
//   as_mermaid(id)   -> a Mermaid flowchart (renders inline on GitHub,
//                       wikis, and the IDE Markdown preview)
//   analyze(sql)     -> the deep one: EXECUTES the query and shows the
//                       optimizer's ESTIMATE next to the ACTUAL rows per
//                       step, flagging misestimates and the stats (table
//                       size, column NDV) that explain them
//
// The first three read PLAN_TABLE (estimates only, no execution).
// `analyze` runs the query — that's the only way to get actual row
// counts and catch where the optimizer guessed wrong.
//
// Workflow:
//   1. populate PLAN_TABLE — `explain_for(id, sql)` (dynamic) or run
//      `EXPLAIN PLAN SET STATEMENT_ID='x' FOR <sql>` yourself.
//   2. render — `p(explain_plan::as_story('x'));`
//                `p(explain_plan::as_tree('x'));`
//
// REPL taste:
//   [1]> explain_plan::explain_for('q1', 'select * from emp where id=7');
//   [2]> p(explain_plan::as_story('q1'));
//   [3]> p(explain_plan::analyze('select * from emp where dept=10'));
// ---------------------------------------------------------------------------

// Plain-English gloss for an operation/options pair. Covers the common
// row sources; falls back to echoing the raw operation so nothing is ever
// unexplained.
pub fn explain_op(operation: text, options: text) -> text {
    let op = upper(operation);
    let opt = upper(options);
    if op == "SELECT STATEMENT" { return "The query result."; }
    if op == "TABLE ACCESS" && opt == "FULL" {
        return "Reads every row of the table (full scan) — fine for small tables, costly for big ones.";
    }
    if op == "TABLE ACCESS" && opt.contains("ROWID") {
        return "Fetches table rows directly by rowid, handed up from an index.";
    }
    if op == "INDEX" && opt == "UNIQUE SCAN" {
        return "Pinpoints a single row through a unique index — the fastest lookup.";
    }
    if op == "INDEX" && opt.contains("RANGE") {
        return "Walks a contiguous range of index entries.";
    }
    if op == "INDEX" && opt.contains("FULL") {
        return "Scans the whole index in order.";
    }
    if op == "INDEX" && opt.contains("SKIP") {
        return "Uses a composite index without its leading column (skip scan).";
    }
    if op == "NESTED LOOPS" {
        return "For each row from the first input, probes the second — good when the first input is small.";
    }
    if op == "HASH JOIN" {
        return "Builds a hash table from one input, then probes it with the other — good for large joins.";
    }
    if op == "MERGE JOIN" {
        return "Merges two already-sorted inputs.";
    }
    if op == "SORT" && opt == "ORDER BY" {
        return "Sorts rows to satisfy ORDER BY.";
    }
    if op == "SORT" && opt.contains("AGGREGATE") {
        return "Collapses all rows into one aggregate (COUNT/SUM/…).";
    }
    if op == "SORT" && opt.contains("UNIQUE") {
        return "Sorts and removes duplicates (DISTINCT / set op).";
    }
    if op == "HASH" && opt.contains("GROUP") {
        return "Groups rows with a hash table for GROUP BY.";
    }
    if op == "SORT" && opt.contains("GROUP") {
        return "Groups rows by sorting them for GROUP BY.";
    }
    if op == "FILTER" {
        return "Keeps only rows passing a predicate.";
    }
    if op == "COUNT" {
        return "Counts / numbers rows (e.g. ROWNUM).";
    }
    if op == "VIEW" {
        return "Materializes an inline view or subquery.";
    }
    if op == "PARTITION RANGE" {
        return "Prunes to the relevant table partitions.";
    }
    if op == "CONNECT BY" {
        return "Walks a hierarchy (CONNECT BY).";
    }
    return operation;
}

// A short, stable CSS class for an operation — drives node colour in the
// Mermaid output. Full scans get flagged (often the thing to fix).
fn op_class(operation: text, options: text) -> text {
    let op = upper(operation);
    let opt = upper(options);
    if op == "TABLE ACCESS" && opt == "FULL" { return "fullscan"; }
    if op == "INDEX" { return "index"; }
    if op.contains("JOIN") || op == "NESTED LOOPS" { return "join"; }
    return "plain";
}

// Render the plan in PLAN_TABLE under `stmt_id` as a Mermaid flowchart.
// Each node shows the operation, object, estimated rows and cost; edges
// run parent → child. Colour flags full table scans.
pub fn as_mermaid(stmt_id: text) -> text {
    var buf: text = mermaid::flowchart("TD");
    buf = buf + mermaid::class_def("fullscan", "fill:#ffe0e0,stroke:#cc0000");
    buf = buf + mermaid::class_def("index", "fill:#e0ffe0,stroke:#009900");
    buf = buf + mermaid::class_def("join", "fill:#e0e8ff,stroke:#3355cc");
    for row in sql! {
        select id,
               nvl(parent_id, -1) as parent_id,
               operation,
               nvl(options, ' ') as options,
               operation
                 || case when options is not null then ' ' || options else '' end
                 || case when object_name is not null then chr(10) || object_name else '' end
                 || case when cardinality is not null then chr(10) || 'rows=' || cardinality else '' end
                 || case when cost is not null then ' cost=' || cost else '' end
                 as label
          from plan_table
         where statement_id = :stmt_id
         order by id
    } {
        let nid = "n{row.id}";
        buf = buf + mermaid::node(nid, row.label);
        buf = buf + mermaid::classify(nid, op_class(row.operation, row.options));
        if row.parent_id >= 0 {
            buf = buf + mermaid::link("n{row.parent_id}", nid);
        }
    }
    return buf;
}

// Decode an index object into `TABLE(col, col) unique|non-unique` from
// the data dictionary, so a step reads `ACCOUNTS(ID) unique` instead of
// the opaque `SYS_C008552`. Falls back to the raw name when nothing is
// found (remote / function-based / freshly-created indexes).
fn index_label(owner: text, name: text) -> text {
    let d = catalog::index_detail(owner, name);
    if d.cols_found == 0 { return name; }
    var uniq: text = "non-unique";
    if d.uniqueness == "UNIQUE" { uniq = "unique"; }
    return "{d.table_name}({d.cols}) {uniq}";
}

// The object a step touches, with an index decoded to its columns.
fn object_label(owner: text, name: text, is_index: number) -> text {
    if is_index == 1 { return index_label(owner, name); }
    return name;
}

// The annotation lines under a step: the plain-English gloss, then the
// access predicate (how rows are *found*) and filter predicate (how rows
// are *discarded*) — the distinction that makes a plan legible. When the
// rows flowing in and out are both known, the filter line says how many
// rows it removed. `pad` is the left margin (indent for the tree, a fixed
// gutter for the story).
fn step_notes(operation: text, options: text,
              has_access: number, access: text,
              has_filter: number, filter: text,
              rows_in: number, rows_out: number, pad: text) -> text {
    var notes: text = pad + "-> " + explain_op(operation, options) + chr(10);
    if has_access == 1 {
        notes = notes + pad + "accessed by: " + access + chr(10);
    }
    if has_filter == 1 {
        var extra: text = "";
        if rows_in > 0 && rows_out >= 0 && rows_in > rows_out {
            let removed = rows_in - rows_out;
            extra = " (discards {removed} of {rows_in})";
        }
        notes = notes + pad + "filtered by:  " + filter + extra + chr(10);
    }
    return notes;
}

// The `rows · cost` suffix, omitting whichever the optimizer didn't set.
fn cardinality_tail(rows_out: number, cost: number) -> text {
    if rows_out >= 0 && cost >= 0 { return "   {rows_out} rows, cost {cost}"; }
    if rows_out >= 0 { return "   {rows_out} rows"; }
    if cost >= 0 { return "   cost {cost}"; }
    return "";
}

// The operation label: `OPERATION OPTIONS  OBJECT`.
fn op_label(operation: text, options: text, has_opt: number,
            has_obj: number, owner: text, name: text, is_index: number) -> text {
    var label: text = operation;
    if has_opt == 1 { label = "{operation} {options}"; }
    if has_obj == 1 { label = label + "  " + object_label(owner, name, is_index); }
    return label;
}

// Render the plan as an indented tree — structure at a glance. Each node
// carries its decoded object, rows/cost, plain-English gloss, and the
// access/filter predicates. PLAN_TABLE.depth drives the indentation.
pub fn as_tree(stmt_id: text) -> text {
    var buf: text = "";
    for row in sql! {
        select p.id,
               p.depth,
               p.operation,
               nvl(p.options, ' ') as options,
               case when p.options is null then 0 else 1 end as has_opt,
               case when p.object_name is null then 0 else 1 end as has_obj,
               case when p.object_type like 'INDEX%' then 1 else 0 end as is_index,
               nvl(p.object_owner, user) as object_owner,
               nvl(p.object_name, ' ') as object_name,
               nvl(p.cardinality, -1) as rows_out,
               nvl(p.cost, -1) as cost,
               case when p.access_predicates is null then 0 else 1 end as has_access,
               nvl(replace(p.access_predicates, chr(34), ''), ' ') as access_pred,
               case when p.filter_predicates is null then 0 else 1 end as has_filter,
               nvl(replace(p.filter_predicates, chr(34), ''), ' ') as filter_pred,
               nvl((select sum(c.cardinality) from plan_table c
                      where c.statement_id = p.statement_id and c.parent_id = p.id), -1) as rows_in,
               rpad(' ', p.depth * 2, ' ') as indent
          from plan_table p
         where p.statement_id = :stmt_id
         order by p.id
    } {
        let head = op_label(row.operation, row.options, row.has_opt,
                            row.has_obj, row.object_owner, row.object_name, row.is_index);
        buf = buf + row.indent + head + cardinality_tail(row.rows_out, row.cost) + chr(10);
        buf = buf + step_notes(row.operation, row.options,
                               row.has_access, row.access_pred,
                               row.has_filter, row.filter_pred,
                               row.rows_in, row.rows_out, row.indent + "    ");
    }
    return buf;
}

// Render the plan as a story — the operations in the order Oracle starts
// them (deepest leaf first, then up), numbered, so it reads like prose.
// A `meanwhile` divider marks where execution jumps to the other input of
// a join. The execution order is post-order DFS, which we get straight
// from PLAN_TABLE by sorting each node on the largest id in its subtree
// (so a subtree's children sort before it), then id descending.
pub fn as_story(stmt_id: text) -> text {
    let hdr_rows: number = sql! {
        select nvl(max(case when id = 0 then cardinality end), -1) as v
          from plan_table where statement_id = :stmt_id
    }.one();
    let hdr_cost: number = sql! {
        select nvl(max(case when id = 0 then cost end), -1) as v
          from plan_table where statement_id = :stmt_id
    }.one();
    var buf: text = "How Oracle runs this";
    if hdr_rows >= 0 { buf = buf + " — {hdr_rows} rows out"; }
    if hdr_cost >= 0 { buf = buf + ", cost {hdr_cost}"; }
    buf = buf + chr(10) + chr(10);
    var step: number = 0;
    var prev_parent: number = -99;
    for row in sql! {
        select p.id,
               nvl(p.parent_id, -1) as parent_id,
               p.operation,
               nvl(p.options, ' ') as options,
               case when p.options is null then 0 else 1 end as has_opt,
               case when p.object_name is null then 0 else 1 end as has_obj,
               case when p.object_type like 'INDEX%' then 1 else 0 end as is_index,
               nvl(p.object_owner, user) as object_owner,
               nvl(p.object_name, ' ') as object_name,
               nvl(p.cardinality, -1) as rows_out,
               nvl(p.cost, -1) as cost,
               case when p.access_predicates is null then 0 else 1 end as has_access,
               nvl(replace(p.access_predicates, chr(34), ''), ' ') as access_pred,
               case when p.filter_predicates is null then 0 else 1 end as has_filter,
               nvl(replace(p.filter_predicates, chr(34), ''), ' ') as filter_pred,
               nvl((select sum(c.cardinality) from plan_table c
                      where c.statement_id = p.statement_id and c.parent_id = p.id), -1) as rows_in
          from plan_table p
         where p.statement_id = :stmt_id
         order by nvl((select min(n.id) from plan_table n
                         where n.statement_id = p.statement_id
                           and n.id > p.id and n.depth <= p.depth) - 1,
                      (select max(m.id) from plan_table m
                        where m.statement_id = p.statement_id)) asc,
                  p.id desc
    } {
        // A jump to a node that isn't the previous step's parent means we
        // finished one input and are starting the next — a "meanwhile".
        if step > 0 && row.id != prev_parent {
            buf = buf + "   --- meanwhile, the other input ---" + chr(10);
        }
        step = step + 1;
        let head = op_label(row.operation, row.options, row.has_opt,
                            row.has_obj, row.object_owner, row.object_name, row.is_index);
        buf = buf + "{step}  " + head + cardinality_tail(row.rows_out, row.cost) + chr(10);
        buf = buf + step_notes(row.operation, row.options,
                               row.has_access, row.access_pred,
                               row.has_filter, row.filter_pred,
                               row.rows_in, row.rows_out, "     ");
        prev_parent = row.parent_id;
    }
    return buf;
}

// num_rows for a table from optimizer stats; -1 when unanalyzed/unknown.
fn table_rows(owner: text, name: text) -> number {
    let r: number = sql! {
        select nvl(max(num_rows), -1) as v
          from all_tables where owner = :owner and table_name = :name
    }.one();
    return r;
}

// Distinct-value count (NDV) for a column from optimizer stats; -1 when
// unknown. This is what the optimizer divides num_rows by to guess how
// many rows an equality predicate keeps — so a wrong NDV (or a skewed
// column with no histogram) is the usual reason an estimate is off.
fn col_ndv(owner: text, name: text, col: text) -> number {
    let r: number = sql! {
        select nvl(max(num_distinct), -1) as v
          from all_tab_col_statistics
         where owner = :owner and table_name = :name and column_name = :col
    }.one();
    return r;
}

// Deep analysis — the expensive tool. EXECUTE the query with row-source
// statistics, then show the plan with the optimizer's ESTIMATE next to
// the ACTUAL rows each step produced. Where they diverge by 10x or more
// the step is flagged: that's where the optimizer guessed wrong, and the
// `stats:` line names the table size + predicate-column NDV that explain
// the guess. The query is run inside `count(*)` so it executes to
// completion without fetching rows back — SELECT statements only.
//
// Needs SELECT on V$SQL_PLAN_STATISTICS_ALL (granted by
// setup_example_schemas.sql).
pub unsafe fn analyze(query: text) -> text {
    // Run the query wrapped in count(*) (forces full execution, no fetch)
    // with a distinctive inline-view alias we can find in V$SQL after.
    let returned: number = exec_dyn(
        "select /*+ gather_plan_statistics */ count(*) from ({query}) pelldeepprobe_src"
    );
    var buf: text = "Deep analysis — executed; the query returns {returned} row(s)." + chr(10);
    buf = buf + "Optimizer estimate vs actual rows, per step:" + chr(10) + chr(10);
    var found: number = 0;
    for row in sql! {
        select p.id,
               p.depth,
               p.operation,
               nvl(p.options, ' ') as options,
               case when p.options is null then 0 else 1 end as has_opt,
               case when p.object_name is null then 0 else 1 end as has_obj,
               case when p.object_type like 'INDEX%' then 1 else 0 end as is_index,
               case when p.object_type like 'TABLE%' then 1 else 0 end as is_table,
               nvl(p.object_owner, user) as object_owner,
               nvl(p.object_name, ' ') as object_name,
               nvl(p.cardinality, -1) as est_rows,
               nvl(p.last_output_rows, -1) as act_rows,
               case when p.cardinality is not null and p.last_output_rows is not null
                         and p.last_output_rows > 0
                    then round(greatest(p.cardinality, p.last_output_rows)
                               / greatest(least(p.cardinality, p.last_output_rows), 1))
                    else -1 end as misfactor,
               case when nvl(p.cardinality, 0) > nvl(p.last_output_rows, 0) then 1 else 0 end as over_est,
               case when p.access_predicates is null then 0 else 1 end as has_access,
               nvl(replace(p.access_predicates, chr(34), ''), ' ') as access_pred,
               case when p.filter_predicates is null then 0 else 1 end as has_filter,
               nvl(replace(p.filter_predicates, chr(34), ''), ' ') as filter_pred,
               nvl(regexp_substr(p.filter_predicates, '"([^"]+)"', 1, 1, null, 1), ' ') as filter_col,
               case when regexp_substr(p.filter_predicates, '"([^"]+)"', 1, 1, null, 1) is null
                    then 0 else 1 end as has_filter_col,
               rpad(' ', p.depth * 2, ' ') as indent
          from v$sql_plan_statistics_all p
         where (p.sql_id, p.child_number) = (
                 select s.sql_id, s.child_number from v$sql s
                  where s.sql_text like '%pelldeep' || 'probe_src%'
                  order by s.last_active_time desc, s.child_number desc
                  fetch first 1 row only)
         order by p.id
    } {
        found = 1;
        let head = op_label(row.operation, row.options, row.has_opt,
                            row.has_obj, row.object_owner, row.object_name, row.is_index);
        var nums: text = "";
        if row.est_rows >= 0 { nums = "   est {row.est_rows}"; }
        if row.act_rows >= 0 {
            if row.est_rows >= 0 { nums = nums + ", actual {row.act_rows}"; }
            else { nums = "   actual {row.act_rows}"; }
        }
        var flag: text = "";
        if row.misfactor >= 10 {
            if row.over_est == 1 { flag = "   << over-estimated {row.misfactor}x >>"; }
            else { flag = "   << under-estimated {row.misfactor}x >>"; }
        }
        buf = buf + row.indent + head + nums + flag + chr(10);
        buf = buf + row.indent + "    -> " + explain_op(row.operation, row.options) + chr(10);
        if row.has_access == 1 {
            buf = buf + row.indent + "    accessed by: " + row.access_pred + chr(10);
        }
        if row.has_filter == 1 {
            buf = buf + row.indent + "    filtered by:  " + row.filter_pred + chr(10);
        }
        // For a table scan, surface the stats that drove the estimate:
        // the table's row count and the filter column's NDV.
        if row.is_table == 1 {
            let nrows = table_rows(row.object_owner, row.object_name);
            if nrows >= 0 {
                var why: text = "table has {nrows} rows";
                if row.has_filter_col == 1 {
                    let ndv = col_ndv(row.object_owner, row.object_name, row.filter_col);
                    if ndv >= 1 {
                        why = why + "; {row.filter_col} has {ndv} distinct value(s)";
                    }
                }
                buf = buf + row.indent + "    stats: " + why + chr(10);
            }
        }
    }
    if found == 0 {
        buf = buf + "  (no row-source statistics found — the query may have failed to "
                  + "execute, or SELECT on V$SQL_PLAN_STATISTICS_ALL isn't granted)" + chr(10);
    }
    return buf;
}

// Convenience: populate PLAN_TABLE for `query` under `stmt_id` (clearing
// any previous rows), so `as_mermaid` / `as_tree` can render it. Dynamic
// because the analysed statement is supplied at runtime — hence `unsafe`.
@touches(plan_table)
pub unsafe fn explain_for(stmt_id: text, query: text) {
    exec_dyn("delete from plan_table where statement_id = '{stmt_id}'");
    exec_dyn("explain plan set statement_id = '{stmt_id}' for {query}");
}

// One-shot: explain `query` and print both renderings to DBMS_OUTPUT.
@touches(plan_table)
pub unsafe fn show(query: text) {
    explain_for("pell_show", query);
    dbms_output::put_line(as_story("pell_show"));
    dbms_output::put_line("  ---- plan structure ----");
    dbms_output::put_line(as_tree("pell_show"));
}
