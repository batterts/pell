module re_demo;

// ---------------------------------------------------------------------------
// `re::` — PCRE-ish regex via the pell_re runtime package.
//
// Surface:
//   re::matches(s, /pattern/)      -> bool
//   re::find(s, /pattern/[, pos])  -> text          // first match or NULL
//   re::find_all(s, /pattern/)     -> list<text>    // all matches
//   re::replace_all(s, /pat/, rep) -> text          // literal replacement (v0)
//   re::split(s, /pattern/)        -> list<text>    // split on every match
//
// Regex literals use `/pattern/` (JavaScript / Perl / Ruby style). Inside
// the literal, `\/` is a literal `/` and the lexer otherwise preserves
// every character including `{`, `}`, `\d`, etc. verbatim.
//
// Supports: literal chars . * + ? {n,m} | (...) [...] [^...] [a-z]
//           shorthand \d \D \w \W \s \S, anchors ^ $ \A \z \b \B
// Excluded (v0): backreferences, lookbehinds, /pattern/flags.
// ---------------------------------------------------------------------------

// Best-effort email shape check. NOT RFC-5322 — that grammar is
// genuinely unparseable by a single regex — but rejects the most common
// "looks wrong" inputs:
//   - empty / missing `@`
//   - two unanchored `@` (e.g. `foo@bar@baz` — the previous \w+@\w+\.\w+
//     pattern passed because re::matches is unanchored and "x@gmail.com"
//     was found as a substring)
//   - missing TLD, single-char TLD, trailing dot, etc.
//
// Local part   `[A-Za-z0-9._%+-]+`   letters, digits, dot, _ % + -
// `@`          exactly one
// Domain       `[A-Za-z0-9-]+(\.[A-Za-z0-9-]+)*`  dot-separated labels
// TLD          `\.[A-Za-z]{2,}`      at least two letters
//
// Anchored \A...\z so re::matches checks the whole string, not a
// substring. For stricter validation, send a verification email — no
// regex is a substitute for a round-trip.
pub fn is_email(s: text) -> bool {
    return re::matches(s, /\A[A-Za-z0-9._%+\-]+@[A-Za-z0-9\-]+(\.[A-Za-z0-9\-]+)*\.[A-Za-z]{2,}\z/);
}

pub fn first_number(s: text) -> text {
    return re::find(s, /\d+/);
}

pub fn all_numbers(s: text) -> list<text> {
    return re::find_all(s, /\d+/);
}

pub fn redact_digits(s: text) -> text {
    return re::replace_all(s, /\d/, "*");
}

pub fn words(s: text) -> list<text> {
    return re::split(s, /\s+/);
}
