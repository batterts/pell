module text_utils;

// ---------------------------------------------------------------------------
// Everyday string utilities — wraps common Oracle text functions and the
// pell `.contains` / `.starts_with` / `.ends_with` / `.is_empty` aliases
// behind a tidy interface so callers don't have to remember which name
// Oracle uses (LENGTH vs LEN, SUBSTR vs SUBSTRING, INSTR vs INDEX_OF, etc.).
// ---------------------------------------------------------------------------

// Length in characters (uses Oracle's LENGTH, not LENGTHB).
pub fn len(s: text) -> number {
    return length(s);
}

// Surrounding-whitespace trim using LTRIM + RTRIM (Oracle's TRIM(BOTH ...)
// requires a separator literal at SQL parse time).
pub fn trim_ws(s: text) -> text {
    return ltrim(rtrim(s));
}

// Lowercase / uppercase. Named `to_lower`/`to_upper` rather than
// `lower`/`upper` to avoid shadowing Oracle's bare-function builtins —
// pell's free-fn resolution prefers same-module fns over builtins, so a
// fn named `lower` calling `lower(s)` would infinitely recurse instead
// of reaching `LOWER(...)`.
pub fn to_lower(s: text) -> text { return lower(s); }
pub fn to_upper(s: text) -> text { return upper(s); }

// 1-indexed substring; semantics match Oracle's SUBSTR(s, start, length).
// A length of 0 returns "" (which becomes NULL by Oracle semantics — see
// memory: `''` is NULL — so callers should treat the absence of value as
// "either empty or genuinely missing").
pub fn substring(s: text, start: number, length: number) -> text {
    return substr(s, start, length);
}

// True when `s` looks blank — NULL, empty, or whitespace-only.
pub fn is_blank(s: text) -> bool {
    return s.is_empty() || trim_ws(s).is_empty();
}

// True when haystack contains needle.
pub fn has(haystack: text, needle: text) -> bool {
    return haystack.contains(needle);
}

// Replace every occurrence of `from_` with `to_`. Named `replace_all`
// rather than `replace` because Oracle's REPLACE has slightly different
// edge-case behavior around NULL replacements; we make ours explicit.
pub fn replace_all(s: text, from_: text, to_: text) -> text {
    return replace(s, from_, to_);
}

// Left-pad with a single character so the result is at least `width` wide.
// Wraps Oracle's LPAD; passing a width <= len(s) returns s unchanged.
pub fn left_pad(s: text, width: number, ch: text) -> text {
    return lpad(s, width, ch);
}

// Right-pad with a single character (RPAD).
pub fn right_pad(s: text, width: number, ch: text) -> text {
    return rpad(s, width, ch);
}

// Split `s` on `delim` into a list<text> via the pell .split() method,
// which lowers to a per-module REGEXP_SUBSTR helper.
pub fn split(s: text, delim: text) -> list<text> {
    let parts: list<text> = s.split(delim);
    return parts;
}

// Count occurrences of `needle` in `haystack`. Uses INSTR-walk semantics
// so overlapping matches are counted only once.
pub fn count_of(haystack: text, needle: text) -> number {
    let n: number = sql! {
        select regexp_count(:haystack, :needle) from dual
    }.one();
    return n;
}

// Reverse the characters in `s`. Oracle's REVERSE is byte-level by default,
// which behaves correctly only for single-byte charsets; for multibyte
// data, callers should use a regexp-based reverse instead.
pub fn reversed(s: text) -> text {
    // REVERSE is an undocumented Oracle function that works in SQL but
    // is NOT callable from PL/SQL (PLS-00201). Wrap it in a sql!{}
    // SELECT so it runs in the SQL engine.
    return sql! { select reverse(:s) from dual }.scalar();
}

// 1-based position of the first occurrence of `needle`, 0 when absent
// (Oracle INSTR semantics).
pub fn index_of(haystack: text, needle: text) -> number {
    return nvl(instr(haystack, needle), 0);
}

// Text before the first `sep` — the whole string when `sep` is absent.
pub fn before(s: text, sep: text) -> text {
    let i = nvl(instr(s, sep), 0);
    if i == 0 {
        return s;
    }
    return substr(s, 1, i - 1);
}

// Text after the first `sep` — "" (NULL) when `sep` is absent.
pub fn after(s: text, sep: text) -> text {
    let i = nvl(instr(s, sep), 0);
    if i == 0 {
        return "";
    }
    return substr(s, i + length(sep));
}

// Text between the first `open` and the next `close` after it.
pub fn text_between(s: text, open: text, close: text) -> text {
    return before(after(s, open), close);
}

// Remove `prefix` from the front when present, else return s unchanged.
pub fn strip_prefix(s: text, prefix: text) -> text {
    if s.starts_with(prefix) {
        return substr(s, length(prefix) + 1);
    }
    return s;
}

// Remove `suffix` from the end when present, else return s unchanged.
pub fn strip_suffix(s: text, suffix: text) -> text {
    if s.ends_with(suffix) {
        return substr(s, 1, length(s) - length(suffix));
    }
    return s;
}

// `s` repeated `n` times ("" for n <= 0).
pub fn repeat_text(s: text, n: number) -> text {
    var acc: text = "";
    for i in 1..=n {
        acc = acc + s;
    }
    return acc;
}

// Every word capitalized (Oracle INITCAP).
pub fn title_case(s: text) -> text {
    return initcap(s);
}

// Join a list of parts with `delim` — the inverse of split().
pub fn join(parts: list<text>, delim: text) -> text {
    var acc: text = "";
    var seen: number = 0;
    for part in parts {
        if seen > 0 {
            acc = acc + delim;
        }
        acc = acc + part;
        seen = seen + 1;
    }
    return acc;
}

// Truncate to at most `max_len` characters, ending in "..." when cut.
pub fn ellipsize(s: text, max_len: number) -> text {
    if nvl(length(s), 0) <= max_len {
        return s;
    }
    return substr(s, 1, max_len - 3) + "...";
}

// Collapse runs of whitespace to single spaces and trim the ends.
pub fn squish(s: text) -> text {
    return trim_ws(regexp_replace(s, "\s+", " "));
}

// `userName` / `UserName` → `user_name`.
pub fn camel_to_snake(s: text) -> text {
    return lower(regexp_replace(s, "([a-z0-9])([A-Z])", "\1_\2"));
}

// `user_name` → `UserName`.
pub fn snake_to_camel(s: text) -> text {
    let parts: list<text> = s.split("_");
    var acc: text = "";
    for part in parts {
        acc = acc + initcap(part);
    }
    return acc;
}

// `s` when it has visible content, otherwise `dflt`.
pub fn default_if_blank(s: text, dflt: text) -> text {
    if is_blank(s) {
        return dflt;
    }
    return s;
}
