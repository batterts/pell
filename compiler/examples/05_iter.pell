// Iterating rows with `for x in sql!{}` — lowers to a cursor FOR loop.

module reports.daily;

import std::logger;

pub record OrderSummary {
  order_id: number,
  total: number,
}

pub fn print_recent(cutoff: date) {
  for row in sql! {
    select order_id, total
    from orders
    where created_at >= :cutoff
    order by created_at desc
  } {
    logger::info(row.order_id);
  }
}
