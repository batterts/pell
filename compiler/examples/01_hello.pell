module hello;

import std::logger;

// The smallest useful pell module: a public function that logs and
// returns an interpolated string. `pub fn` lands in the package spec;
// the body lowers to a PL/SQL FUNCTION. `logger::info` is the std
// logging shim (lowers to a DBMS_OUTPUT-backed call).
pub fn greet(name: text) -> text {
  logger::info("greeting {name}");
  return "hello, {name}";
}
