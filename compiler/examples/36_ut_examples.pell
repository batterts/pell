@suite("pell example vetting — every module behaves, not just compiles", rollback = "manual")
module ut_pell_examples;

import ut;
import hello;
import text_utils;
import json_demo;
import collections_linked_list;
import staffing;
import stock;
import mermaid;
import explain_plan;
import stat_diff;
import charges;
import charge_log;
import country;
import fulfillment;
import demo;
import emp_demo;
import retry_demo;
import dyn_demo;
import pivot_demo;
import jq_demo;
import re_demo;
import re_capture_demo;
import datetime;
import validation;
import paging;
import csv;
import repl_demo;
import dyn_cursor_demo;
import source_stats;
import table_stats;
import stats_repl;
import daily;
import dbms_stats;

// ---------------------------------------------------------------------------
// ut_pell_examples — utPLSQL suite over the deployed examples.
//
// The deploy sweep proves the examples COMPILE; the execution tests
// prove a handful compute. This suite is the systematic layer: every
// public surface gets called with real arguments and its results
// asserted, database-side, where the semantics actually live.
//
//   pell deploy compiler/examples
//   pell exec -e 'ut::run("pell_test.ut_pell_examples");'
//
// Written in pell: `@suite` lowers to --%suite, `@test` to --%test, and
// `ut::expect(...).to_equal(...)` lowers to the native utPLSQL call.
// Setup/teardown: `@beforetest("p")` / `@aftertest("p")` lower to
// --%beforetest(p) / --%aftertest(p) (see t_transfer); `@beforeeach`,
// `@aftereach`, `@beforeall`, `@afterall` lower to their --% forms too.
// ---------------------------------------------------------------------------

@test("hello::greet greets by name")
pub fn t_greet() {
    ut::expect(hello::greet("world")).to_equal("hello, world");
}

@test("text_utils basics: len/trim/case/contains")
pub fn t_text_utils() {
    ut::expect(text_utils::len("abc")).to_equal(3);
    ut::expect(text_utils::trim_ws("  x  ")).to_equal("x");
    ut::expect(text_utils::to_upper("abc")).to_equal("ABC");
    ut::expect(text_utils::has("haystack", "hay")).to_be_true();
    ut::expect(text_utils::is_blank("   ")).to_be_true();
    ut::expect(text_utils::is_blank("x")).to_be_false();
    // slicing around separators
    ut::expect(text_utils::index_of("hello", "ll")).to_equal(3);
    ut::expect(text_utils::before("key=value", "=")).to_equal("key");
    ut::expect(text_utils::after("key=value", "=")).to_equal("value");
    ut::expect(text_utils::text_between("x[mid]y", "[", "]")).to_equal("mid");
    ut::expect(text_utils::strip_prefix("pre_x", "pre_")).to_equal("x");
    ut::expect(text_utils::strip_suffix("x.sql", ".sql")).to_equal("x");
    // building and shaping
    ut::expect(text_utils::repeat_text("ab", 3)).to_equal("ababab");
    ut::expect(text_utils::ellipsize("abcdefghij", 8)).to_equal("abcde...");
    ut::expect(text_utils::squish("  a   b  ")).to_equal("a b");
    ut::expect(text_utils::title_case("hello world")).to_equal("Hello World");
    ut::expect(text_utils::default_if_blank("  ", "dflt")).to_equal("dflt");
    // case conventions
    ut::expect(text_utils::camel_to_snake("userName")).to_equal("user_name");
    ut::expect(text_utils::snake_to_camel("user_name")).to_equal("UserName");
    // split → join round-trip (join takes the list parameter directly)
    let parts = text_utils::split("a-b-c", "-");
    ut::expect(text_utils::join(parts, "+")).to_equal("a+b+c");
    // cross-package list ARGUMENTS: a literal and a locally-built list
    // both adapt to the callee's nominal collection type
    let lit_join = text_utils::join(["x", "y", "z"], "-");
    ut::expect(lit_join).to_equal("x-y-z");
    var grown: list<text> = [];
    grown.append("a");
    grown.append("b");
    let grown_line = csv::to_line(grown);
    ut::expect(grown_line).to_equal("a,b");
}

@test("json_demo builds and reads nested documents")
pub fn t_json_roundtrip() {
    let j = json_demo::build_simple();
    ut::expect(json::get_text(j, "$.name")).to_equal("Alice");
    ut::expect(json::get_number(j, "$.age")).to_equal(30);
    let n = json_demo::build_nested();
    ut::expect(json::get_text(n, "$.user.address.city")).to_equal("NYC");
    ut::expect(json_demo::extract_text(n, "$.user.name")).to_equal("Bob");
    ut::expect(json_demo::has_path(n, "$.meta.created")).to_be_true();
    ut::expect(json_demo::has_path(n, "$.meta.missing")).to_be_false();
}

@test("linked_list: build, summarize, reverse")
pub fn t_linked_list() {
    // Built via cons/nil: list<T> ARGUMENTS across packages still hit
    // the nominal VARRAY mismatch (adapter exists for returns only).
    let l = collections_linked_list::cons(3,
            collections_linked_list::cons(1,
            collections_linked_list::cons(7,
            collections_linked_list::nil())));
    let s = collections_linked_list::summarize(l);
    ut::expect(s.total).to_equal(11);
    ut::expect(s.count).to_equal(3);
    let r = collections_linked_list::reversed(l);
    let s2 = collections_linked_list::summarize(r);
    ut::expect(s2.total).to_equal(11);
    ut::expect(s2.count).to_equal(3);
}

@test("staffing: find, promote, and the NotFound path")
pub fn t_staffing() {
    sql! { delete from hr.employees where id = 9001 };
    sql! { insert into hr.employees(id, name, email, grade)
           values (9001, 'Test Person', 't@example.com', 3) };
    let e = staffing::find_employee(9001)?;
    ut::expect(e.name).to_equal("Test Person");
    staffing::promote(9001)?;
    let e2 = staffing::find_employee(9001)?;
    ut::expect(e2.grade).to_equal(4);
    sql! { delete from hr.employees where id = 9001 };
}

@test("stock::create_sku returns a sequence-assigned id")
pub fn t_stock() {
    let id = stock::create_sku("UT-TEST-1", 5);
    ut::expect(id).to_be_not_null();
    let qty: number = sql! {
        select qty from inventory.skus where id = :id
    }.one();
    ut::expect(qty).to_equal(5);
    sql! { delete from inventory.skus where id = :id };
}

@test("mermaid builders produce well-formed diagram text")
pub fn t_mermaid() {
    let d = mermaid::flowchart("TD")
          + mermaid::node("a", "Start")
          + mermaid::link("a", "a");
    ut::expect(d).to_be_like("flowchart TD%a[\"Start\"]%a --> a%");
    ut::expect(mermaid::esc("say \"hi\" [now]")).to_equal("say 'hi' (now)");
    ut::expect(mermaid::fence("x")).to_be_like("```mermaid%x%```");
}

@test("explain_plan explains the common row sources in plain English")
pub fn t_explain_op() {
    ut::expect(explain_plan::explain_op("TABLE ACCESS", "FULL"))
        .to_be_like("%full scan%");
    ut::expect(explain_plan::explain_op("INDEX", "UNIQUE SCAN"))
        .to_be_like("%unique index%");
    ut::expect(explain_plan::explain_op("HASH JOIN", " "))
        .to_be_like("%hash table%");
}

@test("stat_diff snapshots carry the headline statistics")
pub fn t_stat_diff() {
    let before = stat_diff::snapshot();
    ut::expect(json::get_number(before, "$.logical_reads")).to_be_not_null();
    ut::expect(json::get_number(before, "$.consistent_gets")).to_be_not_null();
    let after = stat_diff::snapshot();
    let r = stat_diff::report(before, after);
    ut::expect(r).to_be_like("%statistic%before%after%delta%");
}

// utPLSQL fixtures for t_transfer. `@beforetest`/`@aftertest` (below)
// name these procedures so they run around that one test:
// setup_transfer seeds a known pair of accounts; teardown_transfer
// removes them. The test body is then just the behavior under test —
// no inline fixture bookkeeping.
pub fn setup_transfer() {
    transaction {
        sql! { delete from billing.accounts where id in (9101, 9102) };
        sql! { insert into billing.accounts(id, balance, frozen) values (9101, 100, 0) };
        sql! { insert into billing.accounts(id, balance, frozen) values (9102, 10, 0) };
    }
}

pub fn teardown_transfer() {
    transaction {
        sql! { delete from billing.accounts where id in (9101, 9102) };
    }
}

@test("charges::transfer moves money between accounts")
@beforetest("setup_transfer")
@aftertest("teardown_transfer")
pub fn t_transfer() {
    let xfer = charges::Transfer { from_id: 9101, to_id: 9102, amt: 40 };
    charges::transfer(xfer)?;
    let b1: number = sql! { select balance from billing.accounts where id = 9101 }.one();
    let b2: number = sql! { select balance from billing.accounts where id = 9102 }.one();
    ut::expect(b1).to_equal(60);
    ut::expect(b2).to_equal(50);
}

@test("reports::daily prints recent orders without error")
pub fn t_daily() {
    sql! { delete from reports.orders where order_id = 9111 };
    sql! { insert into reports.orders(order_id, total, created_at)
           values (9111, 42, sysdate) };
    daily::print_recent(datetime::add_days(datetime::today(), -1));
    ut::expect(1).to_equal(1);
    sql! { delete from reports.orders where order_id = 9111 };
}

@test("lookups::country resolves names and audits")
pub fn t_country() {
    sql! { delete from lookups.countries where code = 'ZZ' };
    sql! { insert into lookups.countries(code, name) values ('ZZ', 'Testland') };
    ut::expect(country::country_name("ZZ")).to_equal("Testland");
    country::audit_log("ut probe");
    sql! { delete from lookups.countries where code = 'ZZ' };
}

@test("orders::fulfillment: fetch, add line, count")
pub fn t_fulfillment() {
    sql! { delete from orders.order_lines where order_id = 9201 };
    sql! { delete from orders.orders where id = 9201 };
    sql! { delete from orders.skus where id = 9301 };
    sql! { insert into orders.orders(id, customer_id, status, total, created_at)
           values (9201, 1, 'NEW', 0, sysdate) };
    sql! { insert into orders.skus(id, qty) values (9301, 10) };
    let o = fulfillment::fetch_order(9201)?;
    ut::expect(o.status).to_equal("NEW");
    let line_id = fulfillment::add_line(9201, 9301, 2)?;
    ut::expect(line_id).to_be_not_null();
    ut::expect(fulfillment::count_lines(9201)).to_equal(1);
    let qty: number = sql! { select qty from orders.skus where id = 9301 }.one();
    ut::expect(qty).to_equal(8);
    sql! { delete from orders.order_lines where order_id = 9201 };
    sql! { delete from orders.orders where id = 9201 };
    sql! { delete from orders.skus where id = 9301 };
}

@test("auditing::charge_log writes the ledger (finally path)")
pub fn t_charge_account() {
    sql! { delete from auditing.ledger where account_id = 9401 };
    let id = charge_log::charge_account(9401, 25);
    ut::expect(id).to_be_not_null();
    let n: number = sql! {
        select count(*) from auditing.ledger where account_id = 9401
    }.one();
    ut::expect(n).to_equal(1);
    sql! { delete from auditing.ledger where account_id = 9401 };
}

