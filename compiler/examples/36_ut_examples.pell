@test("dyn_demo: dynamic count and update")
pub fn t_dyn_sql() {
    sql! { delete from dyn_orders };
    sql! { insert into dyn_orders(id, status) values (1, 'NEW') };
    sql! { insert into dyn_orders(id, status) values (2, 'NEW') };
    ut::expect(dyn_demo::count_in("dyn_orders", "NEW")).to_equal(2);
    dyn_demo::set_status("dyn_orders", "DONE", 1);
    ut::expect(dyn_demo::count_in("dyn_orders", "NEW")).to_equal(1);
    sql! { delete from dyn_orders };
}

