@test("std::datetime: arithmetic, epochs, iso round-trip")
pub fn t_datetime() {
    ut::expect(datetime::now()).to_be_not_null();
    ut::expect(datetime::days_between(
        datetime::today(), datetime::add_days(datetime::today(), 3))).to_equal(3);
    let ts = datetime::parse_iso("2026-06-13T12:00:00");
    ut::expect(datetime::format_iso(ts)).to_be_like("2026-06-13T12:00:00%");
    ut::expect(datetime::epoch(datetime::from_epoch(1750000000))).to_equal(1750000000);
    // calendar helpers — 2026-02-14 is a Saturday in a non-leap year
    let feb = datetime::parse_iso("2026-02-14T15:30:00");
    ut::expect(datetime::format_iso(datetime::start_of_day(feb)))
        .to_be_like("2026-02-14T00:00:00%");
    ut::expect(datetime::format_iso(datetime::start_of_month(feb)))
        .to_be_like("2026-02-01%");
    ut::expect(datetime::format_iso(datetime::end_of_month(feb)))
        .to_be_like("2026-02-28%");
    ut::expect(datetime::format_iso(datetime::start_of_week(feb)))
        .to_be_like("2026-02-09%");      // ISO week starts Monday
    ut::expect(datetime::day_of_week(feb)).to_equal(6);
    ut::expect(datetime::day_name(feb)).to_equal("Saturday");
    ut::expect(datetime::is_weekend(feb)).to_be_true();
    ut::expect(datetime::year_of(feb)).to_equal(2026);
    ut::expect(datetime::month_of(feb)).to_equal(2);
    ut::expect(datetime::day_of(feb)).to_equal(14);
    ut::expect(datetime::hour_of(feb)).to_equal(15);
    ut::expect(datetime::days_in_month(feb)).to_equal(28);
    ut::expect(datetime::is_leap_year(feb)).to_be_false();
    ut::expect(datetime::is_leap_year(datetime::parse_iso("2028-06-01T00:00:00")))
        .to_be_true();
    // ADD_MONTHS clamps end-of-month: Jan 31 + 1 month = Feb 28
    let jan31 = datetime::parse_iso("2026-01-31T00:00:00");
    ut::expect(datetime::format_iso(datetime::add_months_to(jan31, 1)))
        .to_be_like("2026-02-28%");
}

@test("signups::validation: checks pass and compose")
pub fn t_validation() {
    let t = validation::require_text("name", "Ann")?;
    ut::expect(t).to_equal("Ann");
    let e = validation::require_email("ann@example.com")?;
    ut::expect(e).to_equal("ann@example.com");
    let a = validation::require_age(30)?;
    ut::expect(a).to_equal(30);
    let sf = validation::SignupForm { name: "Ann", email: "ann@example.com", age: 30 };
    let form = validation::validate_signup(sf)?;
    ut::expect(form.name).to_equal("Ann");
    // generic gates
    let ml = validation::require_min_length("pw", "secret12", 8)?;
    ut::expect(ml).to_equal("secret12");
    let xl = validation::require_max_length("code", "abc", 5)?;
    ut::expect(xl).to_equal("abc");
    let rng = validation::require_in_range("qty", 5, 1, 10)?;
    ut::expect(rng).to_equal(5);
    // raw string: `{5}` in a regular string would interpolate
    let pat = validation::require_pattern("zip", "90210", `^\d{5}$`)?;
    ut::expect(pat).to_equal("90210");
    let one = validation::require_one_of("size", "M", "S,M,L,XL")?;
    ut::expect(one).to_equal("M");
}

@test("orders::paging: counts, page math, page contents")
pub fn t_paging() {
    sql! { delete from orders.orders where status = 'UTP' };
    sql! { insert into orders.orders(id, customer_id, status, total, created_at)
           values (9501, 1, 'UTP', 1, sysdate) };
    sql! { insert into orders.orders(id, customer_id, status, total, created_at)
           values (9502, 1, 'UTP', 2, sysdate) };
    sql! { insert into orders.orders(id, customer_id, status, total, created_at)
           values (9503, 1, 'UTP', 3, sysdate) };
    ut::expect(paging::count_matching("UTP")).to_equal(3);
    ut::expect(paging::page_count(3, 2)).to_equal(2);
    ut::expect(paging::has_next_page(1, 2, 3)).to_be_true();
    ut::expect(paging::has_next_page(2, 2, 3)).to_be_false();
    let pg = paging::page_of("UTP", 1, 2);
    ut::expect(pg.len()).to_equal(2);
    sql! { delete from orders.orders where status = 'UTP' };
}

@test("data::csv: RFC-4180 parse, header mode, round-trip")
pub fn t_csv() {
    // quote-aware line split: embedded commas and "" escapes
    let cells = csv::parse_line("a,\"b,c\",\"say \"\"hi\"\"\"");
    ut::expect(cells.len()).to_equal(3);
    ut::expect(cells.at(2)).to_equal("b,c");
    ut::expect(cells.at(3)).to_equal("say \"hi\"");
    // whole-document parse: CRLF rows, arbitrary widths
    let p = csv::parse("a,b,c,d,e\r\nx,\"y\ny\",z\n");
    ut::expect(csv::row_count(p)).to_equal(2);
    ut::expect(csv::col_count(p, 1)).to_equal(5);
    ut::expect(csv::col_count(p, 2)).to_equal(3);
    ut::expect(csv::cell(p, 2, 2)).to_equal("y\ny");
    // header mode keys data rows by the first line
    let h = csv::parse_with_header("name,age\nAnn,34\nBob,55");
    ut::expect(csv::row_count(h)).to_equal(2);
    ut::expect(csv::field(h, 2, "age")).to_equal("55");
    // serialization quotes only when needed and round-trips
    ut::expect(csv::quote_field("a,b")).to_equal("\"a,b\"");
    ut::expect(csv::quote_field("plain")).to_equal("plain");
    let rt = csv::parse("a,\"b,c\"\nd,e");
    ut::expect(csv::to_csv(rt)).to_equal("a,\"b,c\"\nd,e");
    let line = csv::to_line(cells);
    ut::expect(line).to_equal("a,\"b,c\",\"say \"\"hi\"\"\"");
}

