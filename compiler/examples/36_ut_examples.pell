@test("agg_library: SQL aggregates compute")
pub fn t_agg_library() {
    let bor: number = sql! {
        select bitwise_or(column_value) from table(sys.odcinumberlist(1, 2, 4))
    }.one();
    ut::expect(bor).to_equal(7);
    let rng: number = sql! {
        select numeric_range(column_value) from table(sys.odcinumberlist(3, 9, 5))
    }.one();
    ut::expect(rng).to_equal(6);
    let hm: number = sql! {
        select round(harmonic_mean(column_value), 3) from table(sys.odcinumberlist(1, 2, 4))
    }.one();
    ut::expect(hm).to_equal(1.714);
    let unq: text = sql! {
        select unique_or_null(column_value) from table(sys.odcivarchar2list('a', 'a'))
    }.one();
    ut::expect(unq).to_equal("a");
}

@test("shapes_demo aggregates: total and sample count")
pub fn t_shapes_aggs() {
    let tot: number = sql! {
        select total_amount(column_value) from table(sys.odcinumberlist(10, 20, 30))
    }.one();
    ut::expect(tot).to_equal(60);
    let cnt: number = sql! {
        select sample_count(column_value) from table(sys.odcinumberlist(1, 2, 3))
    }.one();
    ut::expect(cnt).to_equal(3);
}
