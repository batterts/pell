// Find/promote employees. Exercises records, typed errors, ?
// propagation, and SELECT INTO via .one()?.

module hr.employees;

import std::logger;

pub record Employee {
  id: number,
  name: text,
  email: text,
  grade: number,
}

pub error NotFound { entity: text, id: number }
pub error PolicyViolation { reason: text }

pub fn find_employee(id: number) -> Result<Employee, NotFound> {
  let row = sql! {
    select id, name, email, grade from employees where id = :id
  }.one()?;
  return Ok(row);
}

pub fn promote(id: number) -> Result<Unit, NotFound | PolicyViolation> {
  let e = find_employee(id)?;
  if e.grade >= 9 {
    return Err(PolicyViolation { reason: "already at max grade" });
  }
  sql! { update employees set grade = grade + 1 where id = :id };
  return Ok(());
}
