// Bulk DML and BULK COLLECT INTO — pell equivalent of the canonical
// PL/SQL FORALL + SQL%BULK_ROWCOUNT pattern:
//
//   DECLARE
//     TYPE num_list_type IS TABLE OF NUMBER INDEX BY BINARY_INTEGER;
//     v_nums num_list_type;
//   BEGIN
//     v_nums(1) := 1; v_nums(2) := 3; ...
//     FORALL i IN v_nums.FIRST .. v_nums.LAST
//       INSERT INTO num_table(n) VALUES (v_nums(i));
//     FOR i IN v_nums.FIRST .. v_nums.LAST LOOP
//       DBMS_OUTPUT.PUT_LINE('Inserted '||SQL%BULK_ROWCOUNT(i)||' on '||i);
//     END LOOP;
//   END;
//
// In pell:
//   - `forall`  → FORALL bulk DML
//   - `bulk.rowcount(i)` → SQL%BULK_ROWCOUNT(i)
//   - `bulk.total()`     → SQL%ROWCOUNT
//   - `xs.indices()` → iterate xs.FIRST .. xs.LAST as integers
//   - `xs.at(i)`     → xs(i)
//   - `xs.len()`     → xs.COUNT
//   - `xs.first()` / `xs.last()` → xs.FIRST / xs.LAST
//   - `let xs: list<T> = sql!{ select … }.collect();` → BULK COLLECT INTO

module bulk.demo;

import std::logger;

pub fn insert_many() {
  let nums: list<number> = [1, 3, 5, 7, 11];

  forall n in nums {
    sql! { insert into num_table(n) values (:n) };
  }

  for i in nums.indices() {
    logger::info("Inserted {bulk.rowcount(i)} row(s) on iteration {i}");
  }
}

pub fn read_all() -> number {
  let rows: list<number> = sql! {
    select n from num_table order by n
  }.collect();

  var total: number = 0;
  for i in rows.indices() {
    total = total + rows.at(i);
  }
  return total;
}
