// Bulk insert from a list literal — pell equivalent of:
//
//   DECLARE
//     TYPE num_list_type IS TABLE OF NUMBER INDEX BY BINARY_INTEGER;
//     v_nums num_list_type;
//   BEGIN
//     v_nums (1) := 1;  v_nums (2) := 3;  ...
//     FORALL i IN v_nums.FIRST .. v_nums.LAST
//       INSERT INTO num_table (n) VALUES (v_nums (i));
//     FOR i IN v_nums.FIRST .. v_nums.LAST LOOP
//       DBMS_OUTPUT.PUT_LINE('Inserted '||SQL%BULK_ROWCOUNT(i)||' on '||i);
//     END LOOP;
//   END;
//
// v0 caveat: pell doesn't yet emit FORALL or read SQL%BULK_ROWCOUNT.
// The loop below performs row-by-row inserts (semantically identical;
// less performant). A `bulk` construct that lowers to FORALL is
// post-v0 work.

module bulk.demo;

import std::log;

pub fn insert_many() {
  let nums: list<number> = [1, 3, 5, 7, 11];

  for n in nums {
    sql! { insert into num_table(n) values (:n) };
    log::info("inserted {n}");
  }
}
