// Stub signatures for Oracle's UTL_URL package. Not deployed —
// these are pell-side type/completion hints so consumers can write
// `import utl_url;` and get tab-completion + type checking.
//
// Percent-encodes / decodes URL components.
module utl_url;

// Percent-encode `url`. If escape_reserved is true, also
// escapes RFC 3986 reserved characters (:/?#[]@!$&'()*+,;=).
pub fn escape(url: text, escape_reserved: bool, url_charset: text) -> text { }

// Reverse of escape.
pub fn unescape(url: text, url_charset: text) -> text { }
