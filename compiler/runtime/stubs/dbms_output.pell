// Stub signatures for Oracle's DBMS_OUTPUT package. Not deployed —
// these are pell-side type/completion hints so consumers can write
// `import dbms_output;` and get tab-completion + type checking.
//
// Reference: Oracle Database PL/SQL Packages and Types Reference,
// DBMS_OUTPUT. Bodies are empty `{ }` so the file parses but
// emits no PL/SQL — the canonical implementation is the SYS package.
module dbms_output;

@stub
pub fn put_line(msg: text) { }
@stub
pub fn put(msg: text) { }
@stub
pub fn new_line() { }
@stub
pub fn enable(buffer_size: number) { }
@stub
pub fn disable() { }
@stub
pub fn get_line(out line: text, out status: number) { }
