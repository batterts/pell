source "https://rubygems.org"

# Use the github-pages gem so local builds match what GitHub Pages
# actually deploys. The gem pins jekyll + supported plugins to the
# versions GH Pages currently uses.
gem "github-pages", group: :jekyll_plugins

# just-the-docs is loaded via `remote_theme:` in _config.yml, not as a
# gem. Listing it here is only useful if you want to vendor the theme
# locally to develop against a fork.
# gem "just-the-docs"

group :jekyll_plugins do
  gem "jekyll-remote-theme"
  gem "jekyll-seo-tag"
  gem "jekyll-sitemap"
end

# Windows / JRuby compatibility shims — harmless on macOS / Linux.
platforms :mingw, :x64_mingw, :mswin, :jruby do
  gem "tzinfo", "~> 1.2"
  gem "tzinfo-data"
end
gem "wdm", "~> 0.1.1", :platforms => [:mingw, :x64_mingw, :mswin]
